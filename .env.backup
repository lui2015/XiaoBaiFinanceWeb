# 应用
NODE_ENV=development
APP_BASE_URL=http://localhost:3000

# 数据库（SQLite，数据存在本地 xiaobai.db）
DATABASE_URL="file:./xiaobai.db"

# JWT
JWT_ACCESS_SECRET="8lGpcuZses/5UWq42YBY4u82vwWibLkM6e4MvxxM9dBQ7UBASlvCV3YJDHdpYNQQ"
JWT_REFRESH_SECRET="0FUDtECeoM8T88NT6PT8jG2ocAdvvpMx0rYsFY/jcDc8DPj7MWdsfaDrgV8cRFK+"
JWT_ACCESS_TTL_SEC=900
JWT_REFRESH_TTL_SEC=1209600

# AES-GCM (PII 加密；32 bytes base64)
PII_ENC_KEY="REPLACE_WITH_BASE64_32B_KEY"

# 管理员初始账号（仅 seed 使用；seed 时若该 username 已存在则跳过）
SEED_SUPER_ADMIN_USERNAME=admin
SEED_SUPER_ADMIN_PASSWORD=change-me-to-a-strong-password

# 短信服务（腾讯云 SMS）。开发可设 SMS_PROVIDER=mock
SMS_PROVIDER=mock
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_SMS_REGION=ap-guangzhou
TENCENT_SMS_SDK_APP_ID=
TENCENT_SMS_SIGN_NAME=
TENCENT_SMS_TEMPLATE_ID=

# 对象存储（腾讯云 COS）。开发可设 STORAGE_PROVIDER=local
STORAGE_PROVIDER=local
COS_BUCKET=xiaobai-finance
COS_REGION=ap-guangzhou
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BASE_URL=http://localhost:3000

# 搜索引擎（SQLite 模式不使用 ES）
SEARCH_PROVIDER=memory
